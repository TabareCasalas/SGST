        <di:waypoint x="1080" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Des_To_EBG_di" bpmnElement="F_Des_To_EBG">
        <di:waypoint x="965" y="750" />
        <di:waypoint x="998" y="750" />
        <di:waypoint x="998" y="396" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_SetDes_To_NotifDes_di" bpmnElement="F_SetDes_To_NotifDes">
        <di:waypoint x="615" y="700" />
        <di:waypoint x="658" y="700" />
        <di:waypoint x="658" y="750" />
        <di:waypoint x="795" y="750" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_BndDes_To_SetDes_di" bpmnElement="F_BndDes_To_SetDes">
        <di:waypoint x="860" y="348" />
        <di:waypoint x="860" y="700" />
        <di:waypoint x="615" y="700" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Final_To_EBG_di" bpmnElement="F_Final_To_EBG">
        <di:waypoint x="910" y="155" />
        <di:waypoint x="910" y="258" />
        <di:waypoint x="998" y="258" />
        <di:waypoint x="998" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_SetFinal_To_NotifFinal_di" bpmnElement="F_SetFinal_To_NotifFinal">
        <di:waypoint x="535" y="120" />
        <di:waypoint x="825" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_BndFinal_To_SetFinal_di" bpmnElement="F_BndFinal_To_SetFinal">
        <di:waypoint x="720" y="348" />
        <di:waypoint x="720" y="120" />
        <di:waypoint x="535" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Pend_To_EBG_di" bpmnElement="F_Pend_To_EBG">
        <di:waypoint x="1255" y="595" />
        <di:waypoint x="1255" y="510" />
        <di:waypoint x="1020" y="510" />
        <di:waypoint x="1001" y="393" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_SetPendiente_To_NotifPend_di" bpmnElement="F_SetPendiente_To_NotifPend">
        <di:waypoint x="615" y="560" />
        <di:waypoint x="740" y="560" />
        <di:waypoint x="740" y="620" />
        <di:waypoint x="1085" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_BndPendiente_To_SetPendiente_di" bpmnElement="F_BndPendiente_To_SetPendiente">
        <di:waypoint x="790" y="348" />
        <di:waypoint x="530" y="348" />
        <di:waypoint x="530" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Call_To_End_Default_di" bpmnElement="F_Call_To_End_Default">
        <di:waypoint x="900" y="378" />
        <di:waypoint x="1180" y="418" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_NotifStart_To_CallGestion_di" bpmnElement="F_NotifStart_To_CallGestion">
        <di:waypoint x="640" y="378" />
        <di:waypoint x="680" y="378" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_SetEnTramite_To_NotifStart_di" bpmnElement="F_SetEnTramite_To_NotifStart">
        <di:waypoint x="440" y="378" />
        <di:waypoint x="480" y="378" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Start_To_SetEnTramite_di" bpmnElement="F_Start_To_SetEnTramite">
        <di:waypoint x="216" y="378" />
        <di:waypoint x="280" y="378" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Catch_Cerrar_To_End_di" bpmnElement="F_Catch_Cerrar_To_End">
        <di:waypoint x="1098" y="418" />
        <di:waypoint x="1180" y="418" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_NotifRe_To_CallGestion_di" bpmnElement="F_NotifRe_To_CallGestion">
        <di:waypoint x="1580" y="335" />
        <di:waypoint x="900" y="378" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Shape_Start_Proceso" bpmnElement="Start_Proceso">
        <dc:Bounds x="180" y="360" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="153" y="396" width="90" height="14" />
