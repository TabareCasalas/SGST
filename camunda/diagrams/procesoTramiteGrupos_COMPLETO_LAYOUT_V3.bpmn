<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_SGST_Tramite_Grupo" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.12.0">
  <bpmn:message id="Msg_Inicio_Tramite_Grupo" name="inicio_tramite_grupo">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_To_Pendiente" name="to_pendiente">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_To_Finalizado" name="to_finalizado">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_To_Desistido" name="to_desistido">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_To_EnTramite" name="to_en_tramite">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Cerrar_Tramite" name="cerrar_tramite">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Actualizar_HojaRuta" name="actualizar_hoja_ruta">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Subir_Archivo" name="subir_archivo">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="procesoTramiteGrupos" name="Proceso de Trámite por Grupo (Macro)" isExecutable="true" camunda:historyTimeToLive="365">
    <bpmn:startEvent id="Start_Proceso" name="Inicio desde Ficha">
      <bpmn:outgoing>F_Start_To_SetEnTramite</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Set_EnTramite" name="Registrar estado: en_tramite">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="actualizar-estado" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Start_To_SetEnTramite</bpmn:incoming>
      <bpmn:outgoing>F_SetEnTramite_To_NotifStart</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Notif_Inicio" name="Notificar inicio">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="enviar-notificacion" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_SetEnTramite_To_NotifStart</bpmn:incoming>
      <bpmn:outgoing>F_NotifStart_To_CallGestion</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Call_Gestion_Grupo" name="Gestión del trámite por grupo" calledElement="Proceso_Gestion_Grupo">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Proceso_Gestion_Grupo" />
        <camunda:in source="id_tramite" target="id_tramite" />
        <camunda:in source="id_grupo" target="id_grupo" />
        <camunda:in source="grupoNombre" target="grupoNombre" />
        <camunda:in source="id_consultante" target="id_consultante" />
        <camunda:in source="num_carpeta" target="num_carpeta" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_NotifStart_To_CallGestion</bpmn:incoming>
      <bpmn:incoming>F_NotifRe_To_CallGestion</bpmn:incoming>
      <bpmn:outgoing>F_Call_To_End_Default</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="Bnd_To_Finalizado" name="to_finalizado" attachedToRef="Call_Gestion_Grupo" cancelActivity="true">
      <bpmn:extensionElements>
        <zeebe:subscription correlationKey="=businessKey" />
      </bpmn:extensionElements>
      <bpmn:outgoing>F_BndFinal_To_SetFinal</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1qx3dly" messageRef="Msg_To_Finalizado" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_To_Pendiente" name="to_pendiente" attachedToRef="Call_Gestion_Grupo" cancelActivity="true">
      <bpmn:extensionElements>
        <zeebe:subscription correlationKey="=businessKey" />
      </bpmn:extensionElements>
      <bpmn:outgoing>F_BndPendiente_To_SetPendiente</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1ryor7n" messageRef="Msg_To_Pendiente" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_To_Desistido" name="to_desistido" attachedToRef="Call_Gestion_Grupo" cancelActivity="true">
      <bpmn:extensionElements>
        <zeebe:subscription correlationKey="=businessKey" />
      </bpmn:extensionElements>
      <bpmn:outgoing>F_BndDes_To_SetDes</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1rq321g" messageRef="Msg_To_Desistido" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Set_Pendiente" name="Registrar estado: pendiente">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="actualizar-estado" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_BndPendiente_To_SetPendiente</bpmn:incoming>
      <bpmn:outgoing>F_SetPendiente_To_NotifPend</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Notif_Pendiente" name="Notificar: pendiente">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="enviar-notificacion" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_SetPendiente_To_NotifPend</bpmn:incoming>
      <bpmn:outgoing>F_Pend_To_EBG</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Set_Finalizado" name="Registrar estado: finalizado">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="actualizar-estado" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_BndFinal_To_SetFinal</bpmn:incoming>
      <bpmn:outgoing>F_SetFinal_To_NotifFinal</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Notif_Finalizado" name="Notificar: finalizado">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="enviar-notificacion" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_SetFinal_To_NotifFinal</bpmn:incoming>
      <bpmn:outgoing>F_Final_To_EBG</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Set_Desistido" name="Registrar estado: desistido">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="actualizar-estado" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_BndDes_To_SetDes</bpmn:incoming>
      <bpmn:outgoing>F_SetDes_To_NotifDes</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Notif_Desistido" name="Notificar: desistido">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="enviar-notificacion" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_SetDes_To_NotifDes</bpmn:incoming>
      <bpmn:outgoing>F_Des_To_EBG</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="EBG_PostCambio" name="¿Reanudar o cerrar?">
      <bpmn:incoming>F_Pend_To_EBG</bpmn:incoming>
      <bpmn:incoming>F_Final_To_EBG</bpmn:incoming>
      <bpmn:incoming>F_Des_To_EBG</bpmn:incoming>
      <bpmn:outgoing>F_EBG_To_Catch_ToEnTramite</bpmn:outgoing>
      <bpmn:outgoing>F_EBG_To_Catch_Cerrar</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_To_EnTramite" name="to_en_tramite">
      <bpmn:extensionElements>
        <zeebe:subscription correlationKey="=businessKey" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_EBG_To_Catch_ToEnTramite</bpmn:incoming>
      <bpmn:outgoing>F_Catch_ToEnTramite_To_SetEnTramite</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_To_EnTramite" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_Cerrar" name="cerrar_tramite">
      <bpmn:extensionElements>
        <zeebe:subscription correlationKey="=businessKey" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_EBG_To_Catch_Cerrar</bpmn:incoming>
      <bpmn:outgoing>F_Catch_Cerrar_To_End</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_Cerrar_Tramite" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_Set_EnTramite_Re" name="Registrar estado: en_tramite (reanudar)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="actualizar-estado" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Catch_ToEnTramite_To_SetEnTramite</bpmn:incoming>
      <bpmn:outgoing>F_SetEnTramite_Re_To_NotifRe</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Notif_Reanudar" name="Notificar: reanudado">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="enviar-notificacion" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_SetEnTramite_Re_To_NotifRe</bpmn:incoming>
      <bpmn:outgoing>F_NotifRe_To_CallGestion</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F_NotifRe_To_CallGestion" sourceRef="Task_Notif_Reanudar" targetRef="Call_Gestion_Grupo" />
    <bpmn:endEvent id="End_Proceso" name="Trámite cerrado definitivamente">
      <bpmn:incoming>F_Call_To_End_Default</bpmn:incoming>
      <bpmn:incoming>F_Catch_Cerrar_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Start_To_SetEnTramite" sourceRef="Start_Proceso" targetRef="Task_Set_EnTramite" />
    <bpmn:sequenceFlow id="F_SetEnTramite_To_NotifStart" sourceRef="Task_Set_EnTramite" targetRef="Task_Notif_Inicio" />
    <bpmn:sequenceFlow id="F_NotifStart_To_CallGestion" sourceRef="Task_Notif_Inicio" targetRef="Call_Gestion_Grupo" />
    <bpmn:sequenceFlow id="F_Call_To_End_Default" sourceRef="Call_Gestion_Grupo" targetRef="End_Proceso" />
    <bpmn:sequenceFlow id="F_BndPendiente_To_SetPendiente" sourceRef="Bnd_To_Pendiente" targetRef="Task_Set_Pendiente" />
    <bpmn:sequenceFlow id="F_SetPendiente_To_NotifPend" sourceRef="Task_Set_Pendiente" targetRef="Task_Notif_Pendiente" />
    <bpmn:sequenceFlow id="F_Pend_To_EBG" sourceRef="Task_Notif_Pendiente" targetRef="EBG_PostCambio" />
    <bpmn:sequenceFlow id="F_BndFinal_To_SetFinal" sourceRef="Bnd_To_Finalizado" targetRef="Task_Set_Finalizado" />
    <bpmn:sequenceFlow id="F_SetFinal_To_NotifFinal" sourceRef="Task_Set_Finalizado" targetRef="Task_Notif_Finalizado" />
    <bpmn:sequenceFlow id="F_Final_To_EBG" sourceRef="Task_Notif_Finalizado" targetRef="EBG_PostCambio" />
    <bpmn:sequenceFlow id="F_BndDes_To_SetDes" sourceRef="Bnd_To_Desistido" targetRef="Task_Set_Desistido" />
    <bpmn:sequenceFlow id="F_SetDes_To_NotifDes" sourceRef="Task_Set_Desistido" targetRef="Task_Notif_Desistido" />
    <bpmn:sequenceFlow id="F_Des_To_EBG" sourceRef="Task_Notif_Desistido" targetRef="EBG_PostCambio" />
    <bpmn:sequenceFlow id="F_EBG_To_Catch_ToEnTramite" sourceRef="EBG_PostCambio" targetRef="Catch_To_EnTramite" />
    <bpmn:sequenceFlow id="F_EBG_To_Catch_Cerrar" sourceRef="EBG_PostCambio" targetRef="Catch_Cerrar" />
    <bpmn:sequenceFlow id="F_Catch_ToEnTramite_To_SetEnTramite" sourceRef="Catch_To_EnTramite" targetRef="Task_Set_EnTramite_Re" />
    <bpmn:sequenceFlow id="F_SetEnTramite_Re_To_NotifRe" sourceRef="Task_Set_EnTramite_Re" targetRef="Task_Notif_Reanudar" />
    <bpmn:sequenceFlow id="F_Catch_Cerrar_To_End" sourceRef="Catch_Cerrar" targetRef="End_Proceso" />
  </bpmn:process>
  <bpmn:process id="Proceso_Gestion_Grupo" name="Gestión del trámite por Grupo (Operativo)" isExecutable="true" camunda:historyTimeToLive="365">
    <bpmn:startEvent id="Start_Gestion" name="Inicio gestión">
      <bpmn:outgoing>FG_Start_To_Wait</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_Espera_Activa" name="Gestión activa del trámite" camunda:candidateGroups="${grupoNombre}">
      <bpmn:incoming>FG_Start_To_Wait</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:subProcess id="ESub_HojaRuta" name="Evento: Actualizar hoja de ruta" triggeredByEvent="true">
      <bpmn:startEvent id="ESub_Start_HR" name="Msg: actualizar_hoja_ruta" isInterrupting="false">
        <bpmn:extensionElements>
          <zeebe:subscription correlationKey="=businessKey" />
        </bpmn:extensionElements>
        <bpmn:outgoing>FG_HR_1</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_Actualizar_HojaRuta" />
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask_HojaRuta" name="Actualizar hoja de ruta" camunda:candidateGroups="${grupoNombre}">
        <bpmn:incoming>FG_HR_1</bpmn:incoming>
        <bpmn:outgoing>FG_HR_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="ESub_End_HR">
        <bpmn:incoming>FG_HR_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="FG_HR_1" sourceRef="ESub_Start_HR" targetRef="UserTask_HojaRuta" />
      <bpmn:sequenceFlow id="FG_HR_2" sourceRef="UserTask_HojaRuta" targetRef="ESub_End_HR" />
    </bpmn:subProcess>
    <bpmn:subProcess id="ESub_SubirArchivo" name="Evento: Subir archivos" triggeredByEvent="true">
      <bpmn:startEvent id="ESub_Start_SA" name="Msg: subir_archivo" isInterrupting="false">
        <bpmn:extensionElements>
          <zeebe:subscription correlationKey="=businessKey" />
        </bpmn:extensionElements>
        <bpmn:outgoing>FG_SA_1</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_Subir_Archivo" />
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask_SubirArchivos" name="Subir archivos relevantes" camunda:candidateGroups="${grupoNombre}">
        <bpmn:incoming>FG_SA_1</bpmn:incoming>
        <bpmn:outgoing>FG_SA_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="ESub_End_SA">
        <bpmn:incoming>FG_SA_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="FG_SA_1" sourceRef="ESub_Start_SA" targetRef="UserTask_SubirArchivos" />
      <bpmn:sequenceFlow id="FG_SA_2" sourceRef="UserTask_SubirArchivos" targetRef="ESub_End_SA" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="FG_Start_To_Wait" sourceRef="Start_Gestion" targetRef="UserTask_Espera_Activa" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Macro">
    <bpmndi:BPMNPlane id="BPMNPlane_Macro" bpmnElement="procesoTramiteGrupos">
      <bpmndi:BPMNEdge id="F_SetEnTramite_Re_To_NotifRe_di" bpmnElement="F_SetEnTramite_Re_To_NotifRe">
        <di:waypoint x="1360" y="335" />
        <di:waypoint x="1400" y="335" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Catch_ToEnTramite_To_SetEnTramite_di" bpmnElement="F_Catch_ToEnTramite_To_SetEnTramite">
        <di:waypoint x="1116" y="321" />
        <di:waypoint x="1148" y="321" />
        <di:waypoint x="1148" y="331" />
        <di:waypoint x="1180" y="331" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_EBG_To_Catch_Cerrar_di" bpmnElement="F_EBG_To_Catch_Cerrar">
        <di:waypoint x="1016" y="378" />
        <di:waypoint x="1098" y="418" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_EBG_To_Catch_ToEnTramite_di" bpmnElement="F_EBG_To_Catch_ToEnTramite">
        <di:waypoint x="998" y="360" />
