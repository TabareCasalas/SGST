# Configuración de Deployment SGST
# Copia este archivo a config.env y completa con tus valores

# ============================================
# Servidores
# ============================================

# Servidor de Base de Datos
DB_SERVER_HOST="10.0.0.1"
DB_SERVER_USER="usuario"

# Servidor de Backend
BACKEND_SERVER_HOST="10.0.0.2"
BACKEND_SERVER_USER="usuario"

# Servidor de Frontend
FRONTEND_SERVER_HOST="10.0.0.3"
FRONTEND_SERVER_USER="usuario"

# Servidor de Camunda
CAMUNDA_SERVER_HOST="10.0.0.4"
CAMUNDA_SERVER_USER="usuario"

# ============================================
# Credenciales y Secrets
# ============================================

# Contraseña de PostgreSQL
DB_PASSWORD="tu_contraseña_segura_aqui"

# JWT Secret (generar uno seguro)
JWT_SECRET="genera_un_secret_muy_largo_y_seguro_aqui"

# Refresh Token Secret (generar uno seguro diferente)
REFRESH_SECRET="genera_otro_secret_muy_largo_y_seguro_aqui"

# Token del Orchestrator
ORCHESTRATOR_TOKEN="genera_un_token_seguro_para_orchestrator"

# ============================================
# Notas
# ============================================
# 
# Para generar secrets seguros, puedes usar:
#   openssl rand -base64 32
#
# IMPORTANTE:
# - No subas el archivo config.env al repositorio
# - Mantén estos valores seguros
# - Cambia todas las contraseñas por defecto

